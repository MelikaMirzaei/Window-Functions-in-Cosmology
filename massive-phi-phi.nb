Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Tau]1", "=", 
   RowBox[{"-", "1"}]}], ";", 
  RowBox[{"\[Tau]2", "=", 
   RowBox[{"-", ".9999999"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
     RowBox[{"(", 
      RowBox[{"\[Phi]", "/.", " ", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"\[Phi]c", "/.", " ", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], ")"}]}], "/.", " ", 
    "subs"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], ")"}], "/",
          "\[Tau]2"}], ")"}]}], "/.", " ", "subs"}], ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], ")"}], "/",
          "\[Tau]1"}], ")"}]}], "/.", " ", "subs"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{"\[Tau]1", ",", "\[Tau]2"}], "]"}]}], "Input",

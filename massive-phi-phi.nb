Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"subs", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"H", "->", "1"}], ",", 
      RowBox[{"\[Sigma]", "->", "0.01"}], ",", 
      RowBox[{"\[Delta]", "->", "0.5"}], ",", 
      RowBox[{"\[Nu]", "->", "1"}]}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"\[Tau]1_", ",", "\[Tau]2_"}], "]"}], ":=", 
   RowBox[{"Re", "[", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
        RowBox[{"(", 
         RowBox[{"\[Phi]", "/.", " ", 
          RowBox[{"{", 
           RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"\[Phi]c", "/.", " ", 
          RowBox[{"{", 
           RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], ")"}]}], "/.", " ", 
       "subs"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", 
            RowBox[{"\[Sigma]", "/", "\[Tau]2"}]}], ")"}]}], ",", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", 
            RowBox[{"\[Sigma]", "/", "\[Tau]1"}]}], ")"}]}]}], "}"}], "/.", 
       " ", "subs"}], ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
         RowBox[{"\"\<SingularityHandler\>\"", "->", "\"\<IMT\>\""}]}], 
        "}"}]}], ",", 
      RowBox[{"AccuracyGoal", "->", "6"}], ",", 
      RowBox[{"PrecisionGoal", "->", "5"}], ",", 
      RowBox[{"MaxRecursion", "->", "15"}]}], "]"}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 

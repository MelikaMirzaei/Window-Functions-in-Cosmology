           RowBox[{"(", 
            RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", 
           RowBox[{"\[Sigma]", "/", "\[Tau]2"}]}], ")"}]}], ",", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", 
           RowBox[{"\[Sigma]", "/", "\[Tau]1"}]}], ")"}]}]}], "}"}], "/.", 
      " ", "subs"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
        RowBox[{"\"\<SingularityHandler\>\"", "->", "\"\<IMT\>\""}]}], 

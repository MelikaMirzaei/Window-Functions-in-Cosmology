        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Tau]1", "<", "\[Tau]2", "<", "0"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Tau]2", "/", "\[Tau]1"}], ">", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "\[Delta]"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Delta]"}], ")"}]}], ")"}]}], "/.", " ", 
           "subs"}], ")"}]}]}], "]"}]}], ",", 

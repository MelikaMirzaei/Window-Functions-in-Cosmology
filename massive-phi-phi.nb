     RowBox[{
      RowBox[{
       RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
       RowBox[{"(", 
        RowBox[{"\[Phi]", "/.", " ", 
         RowBox[{"{", 

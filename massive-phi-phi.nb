Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Re", "[", "#", "]"}], "/", 
       RowBox[{"Im", "[", "#", "]"}]}], "&"}], "[", 
     RowBox[{
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
          RowBox[{"(", 
           RowBox[{"\[Phi]", "/.", " ", 
            RowBox[{"{", 
             RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"\[Phi]c", "/.", " ", 
            RowBox[{"{", 
             RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], ")"}]}], "/.", " ",
          "subs"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
              ")"}], "/", "\[Tau]2"}], ")"}]}], ",", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
              ")"}], "/", "\[Tau]1"}], ")"}]}]}], "}"}]}], "]"}], "/.", " ", 
      "subs"}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Tau]1", ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "0.1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Tau]2", ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "0.1"}]}], "}"}], ",", 
   RowBox[{"RegionFunction", "->", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Tau]1", "<", "\[Tau]2", "<", "0"}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Tau]2", "/", "\[Tau]1"}], ">", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "\[Delta]"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"1", "+", "\[Delta]"}], ")"}]}], ")"}]}], "/.", " ", 
         "subs"}], ")"}]}]}], "]"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MaTeX", "[", "\"\<\\\\tau_1\>\"", "]"}], ",", 
      RowBox[{"MaTeX", "[", "\"\<\\\\tau_2\>\"", "]"}], ",", 
      RowBox[{
      "MaTeX", "[", "\"\<\\\\mathrm{C_{\\\\phi \\\\phi}}\>\"", "]"}]}], 
     "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1000"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9965549126175785`*^9, 3.9965550334038715`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"4a36dfd3-d98a-d944-a4a0-6a30571c5974"],


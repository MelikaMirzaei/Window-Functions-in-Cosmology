Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"\[Tau]1_", ",", "\[Tau]2_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"\[Tau]1", ",", "\[Tau]2"}], "]"}], "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
         RowBox[{"(", 
          RowBox[{"\[Phi]", "/.", 
           RowBox[{"{", 
            RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"\[Phi]c", "/.", 
           RowBox[{"{", 
            RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], ")"}]}], "/.", 
        "subs"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", 
             RowBox[{"\[Sigma]", "/", "\[Tau]2"}]}], ")"}]}], ",", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", 
             RowBox[{"\[Sigma]", "/", "\[Tau]1"}]}], ")"}]}]}], "}"}], "/.", 
        "subs"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
          RowBox[{"\"\<SingularityHandler\>\"", "->", "\"\<IMT\>\""}]}], 
         "}"}]}], ",", 
       RowBox[{"AccuracyGoal", "->", "6"}], ",", 
       RowBox[{"PrecisionGoal", "->", "5"}], ",", 
       RowBox[{"MaxRecursion", "->", "15"}]}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"C2", "[", 
    RowBox[{"\[Tau]1_", ",", "\[Tau]2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"C2", "[", 
     RowBox[{"\[Tau]1", ",", "\[Tau]2"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"val", "=", 
        RowBox[{"g", "[", 
         RowBox[{"\[Tau]1", ",", "\[Tau]2"}], "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Im", "[", "val", "]"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}], ",", "Indeterminate", ",", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Re", "[", "val", "]"}], "/", 
          RowBox[{"Im", "[", "val", "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9913023751881046`*^9, 3.9913023751881046`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"607338e3-b4df-ee49-a8ad-5bc8a38a5453"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "30"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"start", " ", "coarse"}], ",", 
    RowBox[{"increase", " ", "once", " ", "it", " ", "works"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Tau]1vals", "=", 
   RowBox[{"Subdivide", "[", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "0.1"}], ",", "n"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Tau]2vals", "=", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "0.1"}], ",", "n"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DistributeDefinitions", "[", 
    RowBox[{"g", ",", "C2", ",", "subs", ",", "\[Delta]"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Tau]1", "<", "\[Tau]2", "<", "0"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Tau]2", "/", "\[Tau]1"}], ">", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "\[Delta]"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Delta]"}], ")"}]}]}], "/.", " ", "subs"}],
            ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", 
           RowBox[{"Quiet", "[", 
            RowBox[{"C2", "[", 
             RowBox[{"\[Tau]1", ",", "\[Tau]2"}], "]"}], "]"}]}], "}"}], ",", 
         "Nothing"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Tau]1", ",", "\[Tau]1vals"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Tau]2", ",", 
         RowBox[{"\\[", "Tau2vals", "]"}]}], "}"}]}], "]"}], "//", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"#", ",", "1"}], "]"}], "&"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot3D", "[", 
  RowBox[{"data", ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Tau]1\>\"", ",", "\"\<\[Tau]2\>\"", ",", "\"\<C\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1000"}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Orange", ",", 
      RowBox[{"Opacity", "[", "0.9", "]"}]}], "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.991302388012989*^9, 3.991302388012989*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"774923a9-138a-0141-bf94-27b45dcd5f36"],

Cell[BoxData[

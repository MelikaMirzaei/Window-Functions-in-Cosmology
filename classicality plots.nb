Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"x", "^", "3"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "+", "x"}], ")"}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "x", "+", 
       RowBox[{"x", "^", "2"}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"x", "^", "5"}]}], ")"}]}], ")"}]}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x = \[Tau]2/\[Tau]1\>\"", 
      ",", "\"\<C normalized (ignoring 15/(2\[Sigma]^3))\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "10"}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Shape of C for 0 < x < 1\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9785018722350883`*^9, 3.978501880321968*^9}},

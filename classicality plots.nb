Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigma", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Cval", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"15", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"sigma", "^", "3"}]}], ")"}]}], ")"}], "*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", "^", "3"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", "x"}], ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "x", "+", 
        RowBox[{"x", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "^", "5"}]}], ")"}]}], ")"}]}]}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Cval", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x = \[Tau]2/\[Tau]1\>\"", ",", "\"\<C\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "10"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<C for \[Sigma] = 1\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.978502081634123*^9, 3.978502081634123*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"1eac3a23-d9cf-4f4d-a6e4-20ae907bb906"],


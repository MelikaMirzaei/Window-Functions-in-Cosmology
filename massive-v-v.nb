Cell[BoxData[{
 RowBox[{
  RowBox[{"subs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"H", "->", "1"}], ",", 
     RowBox[{"\[Sigma]", "->", "0.01"}], ",", 
     RowBox[{"\[Delta]", "->", "0.5"}], ",", 
     RowBox[{"\[Nu]", "->", "1.5"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"-", "\[Pi]"}], " ", "\[Tau]"}], "]"}], "/", "2"}], " ", 
    RowBox[{"HankelH1", "[", 
     RowBox[{"\[Nu]", ",", 
      RowBox[{
       RowBox[{"-", "k"}], " ", "\[Tau]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]", "=", 
   RowBox[{"u", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "H"}], "/", "\[Tau]"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uc", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"-", "\[Pi]"}], " ", "\[Tau]"}], "]"}], "/", "2"}], " ", 
    RowBox[{"HankelH2", "[", 
     RowBox[{"\[Nu]", ",", 
      RowBox[{
       RowBox[{"-", "k"}], " ", "\[Tau]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Phi]c", "=", 
   RowBox[{"uc", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "H"}], "/", "\[Tau]"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d\[Phi]", "=", 
   RowBox[{"D", "[", 
    RowBox[{"\[Phi]", ",", "\[Tau]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d\[Phi]c", "=", 
   RowBox[{"D", "[", 
    RowBox[{"\[Phi]c", ",", "\[Tau]"}], "]"}]}], ";"}], "\n"}], "Input",

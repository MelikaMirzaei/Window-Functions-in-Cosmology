Cell[BoxData[{
 RowBox[{
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Re", "[", "#", "]"}], "&"}], "[", 
      RowBox[{
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
           RowBox[{"(", 
            RowBox[{"\[Phi]", "/.", " ", 
             RowBox[{"{", 
              RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"\[Phi]c", "/.", " ", 
             RowBox[{"{", 
              RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], ")"}]}], "/.", 
          " ", "subs"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
               ")"}], "/", "\[Tau]2"}], ")"}]}], ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
               ")"}], "/", "\[Tau]1"}], ")"}]}]}], "}"}]}], "]"}], "/.", " ", 
       "subs"}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Tau]1", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "0.1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Tau]2", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "0.1"}]}], "}"}], ",", 
    RowBox[{"RegionFunction", "->", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", "z"}], "}"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Tau]1", "<", "\[Tau]2", "<", "0"}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Tau]2", "/", "\[Tau]1"}], ">", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "\[Delta]"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"1", "+", "\[Delta]"}], ")"}]}], ")"}]}], "/.", " ", 
          "subs"}], ")"}]}]}], "]"}]}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<\[Tau]1\>\"", ",", "\"\<\[Tau]2\>\"", ",", "\"\<C\>\""}], 
      "}"}]}], ",", 
    RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"\[Tau]1_", ",", "\[Tau]2_"}], "]"}], ":=", 
   RowBox[{"Re", "[", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
        RowBox[{"(", 
         RowBox[{"\[Phi]", "/.", " ", 
          RowBox[{"{", 
           RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"\[Phi]c", "/.", " ", 
          RowBox[{"{", 
           RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], ")"}]}], "/.", " ", 
       "subs"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{

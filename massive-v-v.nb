Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"Im", "[", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"d\[Phi]", "/.", " ", 
           RowBox[{"{", 
            RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], "/.", " ", "subs"}],
          ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"d\[Phi]c", "/.", " ", 
           RowBox[{"{", 
            RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], "/.", " ", "subs"}],
          ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
              ")"}]}], "/", "\[Tau]2"}], ")"}], "/.", " ", "subs"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
              ")"}]}], "/", "\[Tau]1"}], ")"}], "/.", " ", "subs"}]}], 
        "}"}]}], "]"}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Tau]1", ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "0.1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Tau]2", ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "0.1"}]}], "}"}], ",", 
   RowBox[{"RegionFunction", "->", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Tau]1", "<", "\[Tau]2", "<", "0"}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Tau]2", "/", "\[Tau]1"}], ">", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "\[Delta]"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"1", "+", "\[Delta]"}], ")"}]}], "/.", " ", "subs"}], 
          ")"}]}], ")"}]}]}], "]"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Tau]1\>\"", ",", "\"\<\[Tau]2\>\"", ",", "\"\<C\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"87d32eb1-7571-de4e-9ac6-743fe27c4cf7"],


Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gv", "[", 
    RowBox[{"\[Tau]1_", ",", "\[Tau]2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"gv", "[", 
     RowBox[{"\[Tau]1", ",", "\[Tau]2"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"kmin", ",", "kmax"}], "}"}], ",", 
      RowBox[{
       RowBox[{"kmin", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
              ")"}]}], "/", "\[Tau]2"}], ")"}], "/.", " ", "subs"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"kmax", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
              ")"}]}], "/", "\[Tau]1"}], ")"}], "/.", " ", "subs"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Phi]", "/.", 
             RowBox[{"{", 
              RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], "/.", "subs"}], 
           ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"d\[Phi]c", "/.", 
             RowBox[{"{", 
              RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], "/.", "subs"}], 
           ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "kmin", ",", "kmax"}], "}"}], ",", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
            RowBox[{"\"\<SingularityHandler\>\"", "->", "\"\<IMT\>\""}]}], 
           "}"}]}], ",", 
         RowBox[{"AccuracyGoal", "->", "8"}], ",", 
         RowBox[{"PrecisionGoal", "->", "6"}], ",", 
         RowBox[{"MaxRecursion", "->", "20"}]}], "]"}]}]}], "]"}]}]}], 

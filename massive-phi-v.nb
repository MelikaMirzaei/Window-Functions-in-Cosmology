Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.996539451482937*^9, 3.996539461376999*^9}, {
  3.996539495465332*^9, 3.996539496017601*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"86e5044f-b821-ae45-b0fc-f2fd370a2f22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"subs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"H", "->", "1"}], ",", 
     RowBox[{"\[Sigma]", "->", "0.01"}], ",", 
     RowBox[{"\[Delta]", "->", "0.5"}], ",", 
     RowBox[{"\[Nu]", "->", "1.49"}]}], "}"}]}], ";", 
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"Classicality", " ", "plot"}], "==="}], "*)"}], 
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"integral", ",", "kmin", ",", "kmax", ",", "re", ",", "im"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"kmin", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
              ")"}]}], "/", "\[Tau]2"}], ")"}], "/.", " ", "subs"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"kmax", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
              ")"}]}], "/", "\[Tau]1"}], ")"}], "/.", " ", "subs"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"integral", "=", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Phi]", "/.", " ", 
              RowBox[{"{", 
               RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], "/.", " ", 
             "subs"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"d\[Phi]c", "/.", " ", 
              RowBox[{"{", 
               RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], "/.", " ", 
             "subs"}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "kmin", ",", "kmax"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"re", "=", 
        RowBox[{"Re", "[", "integral", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"im", "=", 
        RowBox[{"Im", "[", "integral", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "im", "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "12"}]}]}], ",", "Indeterminate", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"re", "/", "im"}], "]"}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Tau]1", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "0.1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Tau]2", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "0.1"}]}], "}"}], ",", 
    RowBox[{"RegionFunction", "->", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", "z"}], "}"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Tau]1", "<", "\[Tau]2", "<", "0"}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Tau]2", "/", "\[Tau]1"}], ">", 
          RowBox[{"N", "[", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "\[Delta]"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Delta]"}], ")"}]}], "/.", " ", "subs"}], 
            ")"}], "]"}]}], ")"}]}]}], "]"}]}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MaTeX", "[", "\"\<\\\\tau_1\>\"", "]"}], ",", 
       RowBox[{"MaTeX", "[", "\"\<\\\\tau_2\>\"", "]"}], ",", 
       RowBox[{"MaTeX", "[", "\"\<\\\\mathrm{C_{\\\\phi v}}\>\"", "]"}]}], 
      "}"}]}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"PlotPoints", "->", "25"}], ",", 
    RowBox[{"MaxRecursion", "->", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9916390167810783`*^9, 3.99163901753294*^9}, {
   3.996539444622471*^9, 3.996539445275854*^9}, {3.9965398639239807`*^9, 
   3.9965398877050953`*^9}, 3.9965406355827637`*^9, {3.996541170207155*^9, 

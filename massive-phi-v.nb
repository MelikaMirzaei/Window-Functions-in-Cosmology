Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"13", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Tir", "--"}], "--"}], "--"}], "--"}], "--"}], 
                    "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
                    "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
                    "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
                    "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
                    "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
                "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
         "--"}], "--"}], "--"}], "--"}], "--"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"baseSubs", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"H", "->", "1"}], ",", 
       RowBox[{"\[Sigma]", "->", "0.01"}], ",", 
       RowBox[{"\[Delta]", "->", "0.5"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "g", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{
       RowBox[{"\[Tau]1_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Tau]2_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Nu]val_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", "\[Nu]val"}], "]"}], "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "subs", ",", "kmin", ",", "kmax", ",", "integral", ",", "re", ",", 
          "im"}], "}"}], ",", 
        RowBox[{
         RowBox[{"subs", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"baseSubs", ",", 
            RowBox[{"{", 
             RowBox[{"\[Nu]", "->", "\[Nu]val"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"kmin", "=", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
                ")"}]}], "/", "\[Tau]2"}], ")"}], "/.", " ", "subs"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"kmax", "=", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
                ")"}]}], "/", "\[Tau]1"}], ")"}], "/.", " ", "subs"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"integral", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Phi]", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], "/.", " ", 
               "subs"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"d\[Phi]c", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], "/.", " ", 
               "subs"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "kmin", ",", "kmax"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"re", "=", 
          RowBox[{"Re", "[", "integral", "]"}]}], ";", 
         RowBox[{"im", "=", 
          RowBox[{"Im", "[", "integral", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "im", "]"}], "<", 
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}]}], ",", "Indeterminate", ",", 
           RowBox[{"Abs", "[", 
            RowBox[{"re", "/", "im"}], "]"}]}], "]"}]}]}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"classicalityPlot", "[", 
     RowBox[{"\[Nu]val_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", "\[Nu]val"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]1", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "0.1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]2", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "0.1"}]}], "}"}], ",", 
      RowBox[{"RegionFunction", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", "z"}], "}"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Tau]1", "<", "\[Tau]2", "<", "0"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Tau]2", "/", "\[Tau]1"}], ">", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "\[Delta]"}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", "\[Delta]"}], ")"}]}], ")"}], "/.", " ", 
              "baseSubs"}], "]"}]}], ")"}]}]}], "]"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Tau]1\>\"", ",", "\"\<\[Tau]2\>\"", 
         ",", "\"\<Classicality\>\""}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"PlotPoints", "->", "25"}], ",", 
      RowBox[{"MaxRecursion", "->", "1"}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"\"\<\[Nu] = \>\"", "<>", 
        RowBox[{"ToString", "[", "\[Nu]val", "]"}]}]}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Now", " ", "just", " ", "sweep", " ", 
     RowBox[{"values", ":"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Nu]list", "=", 
     RowBox[{"{", 
      RowBox[{"1.49", ",", "1.499", ",", "1.4999", ",", "1.5"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"plots", "=", 
     RowBox[{"classicalityPlot", "/@", "\[Nu]list"}]}], ";"}], "\n", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{
     RowBox[{"Partition", "[", 
      RowBox[{"plots", ",", "2"}], "]"}], ",", 
     RowBox[{"ImageSize", "->", "900"}]}], "]"}]}]}]], "Input",

      RowBox[{"H", "->", "1"}], ",", 
      RowBox[{"\[Sigma]", "->", "0.01"}], ",", 
      RowBox[{"\[Delta]", "->", "0.5"}], ",", 
      RowBox[{"\[Nu]", "->", "1.5"}]}], "}"}]}], ";", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"Classicality", " ", "plot"}], "==="}], "*)"}], 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"integral", ",", "kmin", ",", "kmax", ",", "re", ",", "im"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"kmin", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
               ")"}]}], "/", "\[Tau]2"}], ")"}], "/.", " ", "subs"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"kmax", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
               ")"}]}], "/", "\[Tau]1"}], ")"}], "/.", " ", "subs"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"integral", "=", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Phi]", "/.", " ", 
               RowBox[{"{", 
                RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], "/.", " ", 
              "subs"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"d\[Phi]c", "/.", " ", 
               RowBox[{"{", 
                RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], "/.", " ", 
              "subs"}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "kmin", ",", "kmax"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"re", "=", 
         RowBox[{"Re", "[", "integral", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"im", "=", 
         RowBox[{"Im", "[", "integral", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "im", "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}], ",", "Indeterminate", ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"re", "/", "im"}], "]"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]1", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "0.1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]2", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "0.1"}]}], "}"}], ",", 
     RowBox[{"RegionFunction", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", "z"}], "}"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Tau]1", "<", "\[Tau]2", "<", "0"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Tau]2", "/", "\[Tau]1"}], ">", 
           RowBox[{"N", "[", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Delta]"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", "+", "\[Delta]"}], ")"}]}], "/.", " ", "subs"}], 
             ")"}], "]"}]}], ")"}]}]}], "]"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Tau]1\>\"", ",", "\"\<\[Tau]2\>\"", 
        ",", "\"\<Classicality\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotPoints", "->", "25"}], ",", 
     RowBox[{"MaxRecursion", "->", "1"}]}], "]"}]}]}]], "Input",

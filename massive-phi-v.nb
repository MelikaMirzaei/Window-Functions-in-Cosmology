        RowBox[{"kmin", ",", "kmax", ",", "integral", ",", "re", ",", "im"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"kmin", "=", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
                ")"}], "/", "\[Tau]2"}], ")"}]}], ",", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
                ")"}], "/", "\[Tau]1"}], ")"}]}]}], "]"}], "/.", " ", 
          "subs"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"kmax", "=", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
                ")"}], "/", "\[Tau]2"}], ")"}]}], ",", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "\[Delta]"}], ")"}], " ", "\[Sigma]"}], 
                ")"}], "/", "\[Tau]1"}], ")"}]}]}], "]"}], "/.", " ", 
          "subs"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"integral", "=", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"k", "^", "4"}], " ", "\[Tau]1", " ", "\[Tau]2", " ", 
             RowBox[{"(", 
              RowBox[{"\[Phi]", "/.", " ", 
               RowBox[{"{", 
                RowBox[{"\[Tau]", "->", "\[Tau]1"}], "}"}]}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"\[Phi]c", "/.", " ", 
               RowBox[{"{", 
                RowBox[{"\[Tau]", "->", "\[Tau]2"}], "}"}]}], ")"}]}], "/.", 
            " ", "subs"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "kmin", ",", "kmax"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"re", "=", 
         RowBox[{"Re", "[", "integral", "]"}]}], ";", 
        RowBox[{"im", "=", 
         RowBox[{"Im", "[", "integral", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "im", "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}], ",", "Indeterminate", ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"re", "/", "im"}], "]"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]1", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "0.1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]2", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "0.1"}]}], "}"}], ",", 
     RowBox[{"RegionFunction", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Tau]1", ",", "\[Tau]2", ",", "z"}], "}"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Tau]1", "<", "0"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{"\[Tau]2", "<", "0"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"\[Tau]1", ",", "\[Tau]2"}], "]"}], "/", 
             RowBox[{"Min", "[", 
              RowBox[{"\[Tau]1", ",", "\[Tau]2"}], "]"}]}], "<", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"1", "-", "\[Delta]"}], ")"}]}], ")"}]}], "/.", " ", 
           "subs"}], ")"}]}]}], "]"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Tau]1\>\"", ",", "\"\<\[Tau]2\>\"", ",", "\"\<C\>\""}], 

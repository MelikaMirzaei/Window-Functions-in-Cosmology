Cell[BoxData[
 RowBox[{
  RowBox[{"subs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"H", "->", "1"}], ",", 
     RowBox[{"\[Sigma]", "->", "0.01"}], ",", 
     RowBox[{"\[Delta]", "->", "0.5"}], ",", 
     RowBox[{"\[Nu]", "->", "1.49"}]}], "}"}]}], ";"}]], "Input",

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"Definitions", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"must", " ", "run", " ", "first"}], ",", 
       RowBox[{"every", " ", "session"}]}], ")"}]}], "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "u", ",", "\[Phi]", ",", "uc", ",", "\[Phi]c", ",", "d\[Phi]", ",", 
      "d\[Phi]c", ",", "\[Tau]", ",", "k", ",", "\[Tau]1", ",", "\[Tau]2"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"-", "\[Pi]"}], " ", "\[Tau]"}], "]"}], "/", "2"}], " ", 
      RowBox[{"HankelH1", "[", 
       RowBox[{"\[Nu]", ",", 
        RowBox[{
         RowBox[{"-", "k"}], " ", "\[Tau]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]", "=", 
     RowBox[{"u", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "H"}], "/", "\[Tau]"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"uc", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"-", "\[Pi]"}], " ", "\[Tau]"}], "]"}], "/", "2"}], " ", 
      RowBox[{"HankelH2", "[", 
       RowBox[{"\[Nu]", ",", 
        RowBox[{
         RowBox[{"-", "k"}], " ", "\[Tau]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]c", "=", 
     RowBox[{"uc", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "H"}], "/", "\[Tau]"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d\[Phi]", "=", 
     RowBox[{"D", "[", 
      RowBox[{"\[Phi]", ",", "\[Tau]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d\[Phi]c", "=", 
     RowBox[{"D", "[", 
      RowBox[{"\[Phi]c", ",", "\[Tau]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subs", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"H", "->", "1"}], ",", 
       RowBox[{"\[Sigma]", "->", "0.01"}], ",", 
       RowBox[{"\[Delta]", "->", "0.5"}], ",", 
       RowBox[{"\[Nu]", "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{
     "Sanity", " ", "check", " ", "before", " ", "running", " ", "the", " ", 
      "full", " ", "plot"}], "==="}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]", "/.", " ", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", "->", 
       RowBox[{"-", "0.5"}]}], "}"}]}], "/.", " ", "subs"}], "\n", 
   RowBox[{
    RowBox[{"d\[Phi]c", "/.", " ", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", "->", 
       RowBox[{"-", "0.3"}]}], "}"}]}], "/.", " ", "subs"}]}]}]], "Input",
